# Server-only configuration. Never use public frontend prefixes for these values.
# Apply migrations before starting the API: npm --prefix backend run migrate
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/handoff
FREESTYLE_API_KEY=replace-with-your-test-key
# Required: generate a random 32-256 character base64url token; do not use this placeholder.
DEMO_TEAM_TOKEN=
HOST=127.0.0.1
PORT=3000
# API and worker must resolve this from the same working directory, or use an absolute path.
EVIDENCE_DIRECTORY=.data/evidence
# Optional, integration tests only: use a disposable database, never shared demo data.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/handoff_test
