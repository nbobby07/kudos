{
  "name": "handoff-verifier",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch src/api.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node --env-file-if-exists=.env dist/api.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixture": "node --test tests/checkout.fixture.mjs",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "pretest:live": "npm run build",
    "test:live": "node --test tests/verification.live.mjs"
  },
  "dependencies": {
    "@playwright/test": "1.63.0",
    "freestyle": "0.2.16",
    "pg": "^8.16.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20",
    "typescript": "^5.9",
    "vitest": "^5.0.3"
  }
}
